{
  "manifest_version": 3,
  "name": "YouTube Channel Downloader",
  "version": "1.0.0",
  "description": "Private local helper UI for downloading permitted YouTube channel content.",
  "key": "",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["http://127.0.0.1:17865/*"],
  "action": {
    "default_title": "YouTube Channel Downloader",
    "default_popup": "popup.html"
  }
}
